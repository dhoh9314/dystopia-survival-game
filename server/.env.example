# Copy this file to .env for local development.

# Local dev: a plain SQLite file. Not used in production once TURSO_DATABASE_URL is set.
DATABASE_URL="file:./dev.db"

# Any long random string works locally. Render's render.yaml auto-generates
# this in production (generateValue: true), so you won't set it there.
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- production only (leave unset for local dev) ---
# From the Turso dashboard after creating a database: `turso db show <name> --url`
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# From: `turso db tokens create <name>`
# TURSO_AUTH_TOKEN="your-token"
